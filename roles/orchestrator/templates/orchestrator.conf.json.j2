{% set config = {
  "ListenAddress": orchestrator_listen_address ~ ':' ~ (orchestrator_port | string),
  "BackendDB": "sqlite3",
  "SQLite3DataFile": "/var/lib/orchestrator/orchestrator.db",
  "MySQLTopologyUser": orchestrator_db_user,
  "MySQLTopologyPassword": orchestrator_db_password,
  "AuthenticationMethod": "basic",
  "HTTPAuthUser": orchestrator_http_user,
  "HTTPAuthPassword": orchestrator_http_password,
  "HostnameResolveMethod": "none",
  "MySQLHostnameResolveMethod": "none",
  "InstancePollSeconds": 5,
  "RecoveryEnabled": orchestrator_recovery_enabled | bool,
  "RecoverMasterClusterFilters": orchestrator_recovery_filters if orchestrator_recovery_enabled | bool else [],
  "RecoverIntermediateMasterClusterFilters": [],
  "ApplyMySQLPromotionAfterMasterFailover": orchestrator_recovery_enabled | bool,
  "FailMasterPromotionIfSQLThreadNotUpToDate": true,
  "RecoveryPeriodBlockSeconds": 3600,
  "PreFailoverProcesses": [orchestrator_fencing_hook ~ ' {failedHost}'] if orchestrator_recovery_enabled | bool else [],
  "PostMasterFailoverProcesses": [orchestrator_routing_hook ~ ' {failedHost} {successorHost}'] if orchestrator_recovery_enabled | bool else []
} %}
{{ config | to_nice_json }}
