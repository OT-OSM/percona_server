#!/bin/bash
# {{ ansible_managed }}
# =============================================================================
# Incremental xtrabackup stream to MinIO
# Runs from replica node
# Structure:
# percona-backup/YYYY-MM-DD/<weekday>/inc_<day>_YYYYMMDD_HHMMSS.xbstream.gz
# =============================================================================

set -o pipefail

# =============================================================================
# Variables
# =============================================================================

ORC_USER="{{ percona_ha_orchestrator_topology_user.name }}"
ORC_PASS="{{ percona_ha_orchestrator_topology_user.password }}"

MINIO_ALIAS="{{ percona_ha_minio_alias }}"
MINIO_BUCKET="{{ percona_ha_minio_bucket }}"

MC="{{ percona_ha_mc_install_path }}"

LOG="{{ percona_ha_backup_log_file }}"
LSN_FILE="{{ percona_ha_backup_lsn_file }}"

XTRABACKUP_PARALLEL="{{ percona_ha_xtrabackup_parallel }}"
XTRABACKUP_COMPRESS_THREADS="{{ percona_ha_xtrabackup_compress_threads }}"

# =============================================================================
# Date-Based Backup Structure
# =============================================================================

WEEK_DATE=$(date +%Y-%m-%d)

DAY_NAME=$(date +%A | tr '[:upper:]' '[:lower:]')

BACKUP_NAME="inc_${DAY_NAME}_$(date +%Y%m%d_%H%M%S)"

MINIO_PATH="${MINIO_BUCKET}/${WEEK_DATE}/${DAY_NAME}"

# =============================================================================
# Logging Function
# =============================================================================

log() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') [$1] $2" | tee -a "$LOG"
}

# =============================================================================
# Validate LSN File
# =============================================================================

if [ ! -f "$LSN_FILE" ]; then
  log "ERROR" "No LSN file found — run full backup first"
  exit 1
fi

LSN=$(cat "$LSN_FILE")

if [ -z "$LSN" ]; then
  log "ERROR" "LSN file is empty"
  exit 1
fi

# =============================================================================
# Start Incremental Backup
# =============================================================================

log "INFO" \
"Starting incremental backup: ${BACKUP_NAME} (base LSN: ${LSN})"

log "INFO" \
"MinIO path: ${MINIO_PATH}/${BACKUP_NAME}.xbstream.gz"

# =============================================================================
# Configure MinIO Alias
# =============================================================================

"${MC}" alias set "${MINIO_ALIAS}" \
  "{{ percona_ha_minio_endpoint }}" \
  "{{ percona_ha_minio_root_user }}" \
  "{{ percona_ha_minio_root_password }}" \
  --insecure > /dev/null 2>&1

# =============================================================================
# Execute Incremental Backup Stream
# =============================================================================

xtrabackup \
  --backup \
  --user="${ORC_USER}" \
  --password="${ORC_PASS}" \
  --stream=xbstream \
  --parallel="${XTRABACKUP_PARALLEL}" \
  --compress \
  --compress-threads="${XTRABACKUP_COMPRESS_THREADS}" \
  --incremental-lsn="${LSN}" \
  2>/tmp/xtrabackup_inc.log \
| "${MC}" pipe --insecure \
  "${MINIO_ALIAS}/${MINIO_PATH}/${BACKUP_NAME}.xbstream.gz"

BACKUP_EXIT=${PIPESTATUS[0]}
UPLOAD_EXIT=${PIPESTATUS[1]}

# =============================================================================
# Validate Backup Status
# =============================================================================

if [ "${BACKUP_EXIT:-1}" -ne 0 ] || [ "${UPLOAD_EXIT:-1}" -ne 0 ]; then

  log "ERROR" \
  "Incremental backup failed! xtrabackup=${BACKUP_EXIT} upload=${UPLOAD_EXIT}"

  tail -5 /tmp/xtrabackup_inc.log >> "$LOG"

  exit 1
fi

# =============================================================================
# Save New LSN
# =============================================================================

NEW_LSN=$(grep "The latest check point" /tmp/xtrabackup_inc.log \
  | awk '{print $NF}' \
  | tr -d "'")

echo "$NEW_LSN" > "$LSN_FILE"

log "INFO" "New LSN saved: ${NEW_LSN}"

# =============================================================================
# Backup Completion
# =============================================================================

log "INFO" \
"Incremental backup complete: ${MINIO_PATH}/${BACKUP_NAME}.xbstream.gz"

# =============================================================================
# Cleanup Old Incremental Backups
# =============================================================================

log "INFO" \
"Cleaning incremental backups older than {{ percona_ha_backup_inc_retention_days }} days"

"${MC}" rm \
  --insecure \
  --recursive \
  --force \
  --older-than {{ percona_ha_backup_inc_retention_days }}d \
  "${MINIO_ALIAS}/${MINIO_BUCKET}/" \
  >> "$LOG" 2>&1 || true

# =============================================================================
# Display Storage Usage
# =============================================================================

log "INFO" "Current storage usage after cleanup:"

"${MC}" du \
  --insecure \
  "${MINIO_ALIAS}/${MINIO_BUCKET}/" \
  2>/dev/null | tee -a "$LOG"

# =============================================================================
# Backup Success
# =============================================================================

log "INFO" "Incremental backup workflow completed successfully"

