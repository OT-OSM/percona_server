{{ ansible_managed | comment }}

# =============================================================================
# Percona Server Configuration
# =============================================================================

[client]
port   = {{ percona_port }}
socket = {{ percona_socket }}

# =============================================================================
# MySQL Server
# =============================================================================

[mysqld]

# -----------------------------------------------------------------------------
# Basic Configuration
# -----------------------------------------------------------------------------

port         = {{ percona_port }}
bind-address = {{ percona_bind_address }}

datadir = {{ percona_datadir }}
socket  = {{ percona_socket }}

pid-file = {{ percona_pid_file | default('/var/run/mysqld/mysqld.pid') }}

{% if percona_skip_name_resolve %}
skip-name-resolve
{% endif %}

{% if percona_sql_mode %}
sql_mode = {{ percona_sql_mode }}
{% endif %}

# -----------------------------------------------------------------------------
# Security / CIS Hardening
# -----------------------------------------------------------------------------

skip-grant-tables = OFF
log-raw           = OFF
local-infile      = 0
skip-symbolic-links = YES

# validate_password is installed as COMPONENT via secure-installation tasks.
# Runtime variables are configured after component installation.

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

{% if percona_log_error == 'syslog' or percona_log == 'syslog' %}

syslog
syslog-tag = {{ percona_syslog_tag | default('mysql') }}

{% else %}

{% if percona_log %}
log = {{ percona_log }}
{% endif %}

{% if percona_log_error %}
log-error = {{ percona_log_error }}
{% endif %}

{% endif %}

# -----------------------------------------------------------------------------
# Slow Query Log
# -----------------------------------------------------------------------------

{% if percona_slow_query_log_enabled %}

slow_query_log      = 1
slow_query_log_file = {{ percona_slow_query_log_file }}
long_query_time     = {{ percona_slow_query_time }}

{% endif %}

# -----------------------------------------------------------------------------
# Server Identity
# -----------------------------------------------------------------------------

server-id = {{ percona_server_id }}

# =============================================================================
# Replication Configuration — MASTER
# =============================================================================

{% if inventory_hostname in groups[percona_master_group] | default([]) %}

log_bin                    = mysql-bin
log-bin-index              = mysql-bin.index

binlog_expire_logs_seconds = {{ percona_binlog_expire_logs_seconds }}
max_binlog_size            = {{ percona_max_binlog_size }}

binlog_format = {{ percona_binlog_format }}

{% if percona_gtid_mode | default(false) %}

# GTID Replication

gtid_mode                = ON
enforce_gtid_consistency = ON
log_replica_updates      = ON

{% endif %}

{% for db in percona_databases %}

{% if db.replicate | default(1) %}

binlog_do_db = {{ db.name }}

{% else %}

binlog_ignore_db = {{ db.name }}

{% endif %}

{% endfor %}

# =============================================================================
# Replication Configuration — REPLICA
# =============================================================================

{% elif inventory_hostname in groups[percona_slave_group] | default([]) %}

read_only       = ON
super_read_only = ON

relay-log       = relay-bin
relay-log-index = relay-bin.index

{% if percona_gtid_mode | default(false) %}

gtid_mode                = ON
enforce_gtid_consistency = ON
log_replica_updates      = ON

{% endif %}

{% endif %}

# -----------------------------------------------------------------------------
# MySQL User
# -----------------------------------------------------------------------------

user = mysql

# =============================================================================
# Memory Settings
# =============================================================================

key_buffer_size         = {{ percona_key_buffer_size }}

max_allowed_packet      = {{ percona_max_allowed_packet }}

table_open_cache        = {{ percona_table_open_cache }}

sort_buffer_size        = {{ percona_sort_buffer_size }}

read_buffer_size        = {{ percona_read_buffer_size }}

read_rnd_buffer_size    = {{ percona_read_rnd_buffer_size }}

myisam_sort_buffer_size = {{ percona_myisam_sort_buffer_size }}

thread_cache_size       = {{ percona_thread_cache_size }}

max_connections         = {{ percona_max_connections }}

tmp_table_size          = {{ percona_tmp_table_size }}

max_heap_table_size     = {{ percona_max_heap_table_size }}

group_concat_max_len    = {{ percona_group_concat_max_len }}

join_buffer_size        = {{ percona_join_buffer_size }}

# -----------------------------------------------------------------------------
# Timeout / Scheduler
# -----------------------------------------------------------------------------

wait_timeout           = {{ percona_wait_timeout }}

lower_case_table_names = {{ percona_lower_case_table_names }}

event_scheduler        = {{ percona_event_scheduler_state }}

# =============================================================================
# InnoDB Settings
# =============================================================================

innodb_file_per_table          = {{ percona_innodb_file_per_table }}

innodb_buffer_pool_size        = {{ percona_innodb_buffer_pool_size }}

innodb_log_file_size           = {{ percona_innodb_log_file_size }}

innodb_log_buffer_size         = {{ percona_innodb_log_buffer_size }}

innodb_flush_log_at_trx_commit = {{ percona_innodb_flush_log_at_trx_commit }}

innodb_lock_wait_timeout       = {{ percona_innodb_lock_wait_timeout }}

# =============================================================================
# mysqldump
# =============================================================================

[mysqldump]

quick

max_allowed_packet = {{ percona_mysqldump_max_allowed_packet }}

# =============================================================================
# Additional Configuration Includes
# =============================================================================

{% if percona_config_include_files | length %}

!includedir {{ percona_config_include_dir }}

{% endif %}
